# ------------------------------------------------------------
# Copy to .env and fill in real values.  .env is gitignored.
# ------------------------------------------------------------

# ---- PostgreSQL (your hrms_face database) ----
PG_HOST=localhost
PG_PORT=5432
PG_DB=hrms_face
PG_USER=hrms_user
PG_PASSWORD=change_me
# Optional: full DSN overrides the parts above if set
# PG_DSN=postgresql://hrms_user:change_me@localhost:5432/hrms_face

# ---- Model files (see models/README.md to download) ----
YUNET_MODEL=models/face_detection_yunet_2023mar.onnx
SFACE_MODEL=models/face_recognition_sface_2021dec.onnx
# Silent-Face anti-spoofing ONNX models (two scales)
ANTISPOOF_MODEL_1=models/2.7_80x80_MiniFASNetV2.onnx
ANTISPOOF_MODEL_2=models/4_0_0_80x80_MiniFASNetV1SE.onnx

# ---- Recognition thresholds ----
# SFace cosine similarity: >= this means "same person" (OpenCV default ~0.363)
FACE_MATCH_COSINE=0.38
# Detector minimum score to accept a face
DETECT_SCORE_THRESHOLD=0.8

# ---- Liveness thresholds ----
# Passive: Silent-Face "real" probability must be >= this
LIVENESS_PASSIVE_THRESHOLD=0.70
# Active: how far the head must turn (normalized yaw) to count as a turn
LIVENESS_TURN_THRESHOLD=0.22
# Set true if your camera feed is mirrored (selfie view). Flips left/right.
LIVENESS_MIRROR=false
# Seconds a punch-in challenge stays valid after it is issued
CHALLENGE_TTL_SECONDS=30

# ---- OCR / KYC (PAN, Aadhaar, bank) ----
OCR_ENABLED=true
OCR_USE_ANGLE_CLS=true
OCR_TEXT_SCORE=0.5
# UIDAI restricts storing the full Aadhaar number; keep this true to return
# only the last 4 digits (XXXX XXXX 1234).
OCR_AADHAAR_MASK=true

# ---- Auth (JWT from HRMS). Leave AUTH_ENABLED=false to skip during local dev ----
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256

# ---- CORS (comma separated; use * only for local dev) ----
CORS_ORIGINS=*
